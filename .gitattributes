# ==============================================================================
# GitHub Linguist Language Detection Configuration
# ==============================================================================

# Treat Vitis HLS generated database files and reports as vendored / documentation
*.adb linguist-vendored
*.bda linguist-vendored
*.rpt linguist-documentation
*.tcl.rpt linguist-documentation
*.xml linguist-vendored
*.log linguist-documentation

# Treat Vivado generated block design and IP configuration as vendored
*.xci linguist-vendored
*.bd linguist-vendored
*.ui linguist-vendored
*.xsa binary

# Treat Vitis autogenerated BSP and platform files as vendored
vitis_workspace/zedboard_platform/** linguist-vendored

# Treat Vitis HLS synthesis outputs and exported IP HDL as vendored
hls/**/solution1/** linguist-vendored

# Enforce primary detection on human-authored C/C++ HLS and bare-metal software
hls/**/src/* linguist-detectable=true
hls/**/testbench/* linguist-detectable=true
sw/src/* linguist-detectable=true
